rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user can write their own doc
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Scores: anyone authenticated can write; anyone can read
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
